# =========================================================
# youtube-analyzer API — .env.example
# Copiar para api/.env e preencher. NÃO commitar api/.env.
# =========================================================

APP_ENV=development
APP_NAME=youtube-analyzer-api

# Banco (MySQL no EasyPanel)
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
# Em produção (dentro do EasyPanel) usar o Host Interno, ex:
#   mysql+pymysql://youtubeanalyzer:SENHA@banco_youtube-analyzer-banco:3306/youtube-analyzer-banco
# Localmente, apontar para um host acessível (XAMPP, tunnel, ou IP público do EasyPanel)
DATABASE_URL=mysql+pymysql://youtubeanalyzer:TROCAR_SENHA@localhost:3306/youtube-analyzer-banco

# Chave mestra para cifrar secrets persistidos (ex.: YouTube API keys).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ATENÇÃO: se perdida, todos os secrets cifrados ficam irrecuperáveis.
APP_SECRET_KEY=

# Intervalo default de sincronização automática
SYNC_INTERVAL_HOURS=12

# Origens permitidas (separadas por vírgula) para CORS do frontend Next.js
CORS_ORIGINS=http://localhost:3000
